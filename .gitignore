# Python cache/bytecode
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]

# Test/build cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# Virtual environments
.venv/
.venv*/
venv/
env/

# Runtime outputs and logs
output/
output_*/
logs/
*.log

# Local environment files
.env
.env.*
!.env.example

# Model/cache artifacts (heavy, reproducible)
assets/cache/
assets/models
# OS / editor
.DS_Store
Thumbs.db
.idea/
assets/
# Tauri/Node local build artifacts
webtoon-translator-native/node_modules/
webtoon-translator-native/src-tauri/target/

# Temporary workspace files
.tmp_pip/


manhwa/
oeuvres/

temp/

# Artefacts de debug (--debug) : crops individuels + visualisations,
# volumineux et régénérables, pas le livrable final.
manhwa_trad/**/debug/
output*/**/debug/

# Sorties de tests/dry_run_chapter.py : régénérées à chaque run, pas un livrable.
tests/dry_run_out/
# Sorties d'iteration du rendu — plusieurs Go, ne doivent jamais etre versionnees
scratch/render_out/
# Cache + runs du bareme de rendu (scratch/bareme.py) : ~856 Mo, regenerables
# par `bareme.py build` puis `score`. Le CODE du bareme, lui, est versionne.
scratch/bareme/
scratch/audit_propre/
scratch/diag/
manhwa_trad/
traductions_propres/
